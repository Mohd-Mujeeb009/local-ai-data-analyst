# Copy to .env and fill in. The app also accepts the key via the sidebar.
GROQ_API_KEY=gsk_your_key_here

# Optional model overrides. Leave unset to use the built-in fallback chain,
# which probes availability at runtime and picks the first reachable model.
# Current IDs: https://console.groq.com/docs/models
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
